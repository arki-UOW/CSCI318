# AI_PROVIDER may be auto, gemini, or openai. Auto prefers Gemini when both keys exist.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional alternative provider.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
SUBJECT_SERVICE_URL=http://localhost:8081
ASSESSMENT_SERVICE_URL=http://localhost:8082
STUDY_ACTIVITY_SERVICE_URL=http://localhost:8083
PLANNING_SERVICE_URL=http://localhost:8084
